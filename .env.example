# Produção: banco PostgreSQL público (Neon, Supabase, Render etc.)
DATABASE_URL=postgresql://USER:SENHA@HOST/BANCO?sslmode=require

# Cloudflare R2 / AWS S3 (S3-compatible)
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=amor-por-fotos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket/CDN, sem barra final
S3_PUBLIC_URL=https://imagens.seudominio.com

# URL que será codificada no QR. Use o domínio final com HTTPS.
PUBLIC_APP_URL=https://app.seudominio.com
ADMIN_PIN=troque-este-pin
PORT=3000
