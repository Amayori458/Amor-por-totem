# Postgres (ex.: connection string "Transaction pooler" do Supabase)
DATABASE_URL=postgres://usuario:senha@host:6543/postgres
# Senha para entrar no app
APP_PASSWORD=troque-esta-senha
# Token que o Atalho do iPhone usa para enviar lançamentos (use um valor longo e aleatório)
INGEST_TOKEN=troque-este-token
